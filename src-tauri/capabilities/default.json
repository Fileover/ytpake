{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pake-capability",
  "description": "Capability for the tabbed Pake shell: the local tab strip and every content webview.",
  "webviews": ["pake", "pake-*"],
  "permissions": [
    "allow-download-file",
    "allow-send-notification",
    "allow-close-notification",
    "allow-increment-dock-badge",
    "allow-set-dock-badge",
    "allow-set-dock-badge-label",
    "allow-clear-dock-badge",
    "allow-update-theme-mode",
    "allow-set-zoom",
    "allow-webview-navigate",
    "allow-set-title-bar-color",
    "allow-tabs-new",
    "allow-tabs-close",
    "allow-tabs-close-active",
    "allow-tabs-activate",
    "allow-tabs-select",
    "allow-tabs-cycle",
    "allow-tabs-navigate",
    "allow-tabs-reload",
    "allow-tabs-back",
    "allow-tabs-forward",
    "allow-tabs-state",
    "allow-tabs-fullscreen",
    "allow-tabs-extension-menu",
    "allow-tabs-open-external",
    "shell:allow-open",
    "core:event:default",
    "core:window:allow-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-resizable",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-print",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-get-active",
    "notification:allow-register-listener",
    "notification:allow-register-action-types",
    "notification:default",
    "core:path:default"
  ]
}
