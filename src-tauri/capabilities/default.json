{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pake-capability",
  "description": "Capability for the tabbed YouTube shell: the local tab strip and every content webview.",
  "local": true,
  "remote": {
    "urls": [
      "https://www.youtube.com/*",
      "https://*.youtube.com/*",
      "https://youtube-nocookie.com/*",
      "https://*.youtube-nocookie.com/*",
      "https://youtu.be/*"
    ]
  },
  "webviews": ["pake", "pake-*"],
  "permissions": [
    "allow-tabs-new",
    "allow-tabs-close",
    "allow-tabs-close-active",
    "allow-tabs-activate",
    "allow-tabs-select",
    "allow-tabs-cycle",
    "allow-tabs-navigate",
    "allow-tabs-reload",
    "allow-tabs-back",
    "allow-tabs-forward",
    "allow-tabs-state",
    "allow-tabs-fullscreen",
    "allow-tabs-extension-menu",
    "allow-tabs-open-external",
    "core:event:default",
    "core:window:allow-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-resizable",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-print",
    "core:path:default"
  ]
}
