{
  "productName": "YouTube",
  "mainBinaryName": "YouTube",
  "identifier": "com.pake.youtube.tabs",
  "version": "1.0.0",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "headers": {},
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "png/youtube_256.ico",
      "png/youtube_32.ico",
      "png/youtube_512.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
